---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout>

    <Navbar />

    <main class="hero">

        <h1>Software that empowers ideas.</h1>

        <p>We create modern software for people, businesses and startups.</p>

    </main>

    <footer class="foot">
        <p>
            © 2026 Cartoony Studio
        </p>
    </footer>


</Layout>

<style>
    .hero {
        margin-top: 9rem;
        text-align: center;
    }

    .hero h1 {
        font-size: 1.75rem;
        font-weight: normal;
    }

    .hero p {
        max-width: 39ch;
        margin: 3.5rem auto 0;
        font-size: 1.3rem;
        line-height: 1.6;
    }
    .foot p {
        text-align: center;
        margin: 3.5rem auto 0;
    }
</style>
