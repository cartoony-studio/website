---
import "../styles/variables.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cartoony Studio",
  description = "Software that empowers ideas."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" />

    <!-- Recuerda el tema elegido antes de dibujar la página -->
    <script is:inline>
        const temaGuardado = localStorage.getItem("tema");
        if (temaGuardado) {
            document.documentElement.dataset.theme = temaGuardado;
        }
    </script>

</head>

<body>

    <slot />

</body>
</html>
