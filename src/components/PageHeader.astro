---
interface Props {
    kicker: string;
    title: string;
    lead?: string;
}

const { kicker, title, lead } = Astro.props;
---

<header class="page-header">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
</header>

<style>
    .page-header {
        width: min(44rem, calc(100% - 3rem));
        margin: 8rem auto 0;
        text-align: center;
    }

    .kicker {
        color: var(--accent);
        font-size: 0.75rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
    }

    h1 {
        margin-top: 1.25rem;
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        font-weight: normal;
        line-height: 1.25;
    }

    .lead {
        max-width: 46ch;
        margin: 1.75rem auto 0;
        color: var(--text-soft);
        font-size: 1.05rem;
        line-height: 1.65;
    }

    @media (max-width: 900px) {
        .page-header {
            margin-top: 4.5rem;
        }
    }
</style>
