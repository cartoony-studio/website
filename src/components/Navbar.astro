---
const links = [
    { href: "/cartoony-series", label: "Cartoony Series" },
    { href: "/projects", label: "Projects" },
    { href: "/services", label: "Services" },
    { href: "/studio", label: "Studio" },
    { href: "/contact", label: "Contact" },
];

const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="navbar">

    <a class="logo" href="/">Cartoony Studio</a>

    <nav class="links" aria-label="Main">
        {links.map((link) => (
            <a
                href={link.href}
                class:list={["link", { active: current === link.href }]}
                aria-current={current === link.href ? "page" : undefined}
            >{link.label}</a>
        ))}
    </nav>

    <!-- Aquí irá tu icono. Por ahora es un círculo, y sirve para cambiar de tema. -->
    <button class="theme-toggle" id="theme-toggle" aria-label="Switch theme"></button>

</header>

<style>
    .navbar {
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin: 25px 40px;
        padding: 1px;
        background: var(--navbar-bg);
        border-radius: 999px;
        transition: background 0.2s;
    }

    .logo {
        padding: 5px 50px;
        background: var(--accent);
        border-radius: 500px;
        color: #FFFFFF;
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: none;
    }

    .links {
        overflow-x: auto;
        display: flex;
        gap: 7rem;
        scrollbar-width: thin;
        scrollbar-color: var(--accent) transparent;
    }

    .links a {
        color: var(--text-soft);
        font-size: 0.95rem;
        text-decoration: none;
        transition: color 0.15s;
    }

    .links a:hover,
    .links a:focus-visible {
        color: var(--text);
    }

    .links a.active {
        color: var(--text);
        border-bottom: 1px solid var(--accent);
        padding-bottom: 2px;
    }

    .theme-toggle {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        margin-right: 4px;
        background: var(--accent);
        border: none;
        cursor: pointer;
        border-radius: 50%;
    }

    .theme-toggle:hover {
        filter: brightness(1.15);
    }

    @media (max-width: 1200px) {
        .links {
            gap: 3rem;
        }
    }

    @media (max-width: 900px) {
        .navbar {
            flex-wrap: wrap;
            white-space: normal;
            gap: 0.85rem;
            margin: 16px;
            padding: 0.6rem 0.75rem;
            border-radius: 1.5rem;
        }

        .logo {
            padding: 4px 18px;
            font-size: 1.1rem;
        }

        .theme-toggle {
            margin-left: auto;
        }

        .links {
            order: 3;
            width: 100%;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.6rem 1.4rem;
            padding-bottom: 0.35rem;
            overflow: visible;
        }

        .links a {
            font-size: 0.85rem;
            white-space: nowrap;
        }
    }
</style>

<script>
    const boton = document.getElementById("theme-toggle");

    boton.addEventListener("click", () => {
        const html = document.documentElement;
        const nuevoTema = html.dataset.theme === "light" ? "dark" : "light";

        html.dataset.theme = nuevoTema;
        localStorage.setItem("tema", nuevoTema);
    });
</script>
