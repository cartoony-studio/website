<header class="navbar">

    <a class="logo" href="/">Cartoony Studio</a>

    <nav class="links">
        <a href="/cartoony-series">Cartoony Series</a>
        <a href="/projects">Projects</a>
        <a href="/services">Services</a>
        <a href="/studio">Studio</a>
        <a href="/contact">Contact</a>
    </nav>

    <!-- Aquí irá tu icono. Por ahora es un círculo, y sirve para cambiar de tema. -->
    <button class="theme-toggle" id="theme-toggle" aria-label="Cambiar tema"></button>

</header>

<style>
    .navbar {
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin: 25px 40px;
        padding: 1px;
        background: var(--navbar-bg);
        border-radius: 999px;
        transition: background 0.2s;
    }

    .logo {
        padding: 5px 50px;
        background: var(--accent);
        border-radius: 500px;
        color: #FFFFFF;
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: none;
    }

    .links {
        overflow-x: auto;
        display: flex;
        gap: 7rem;
        scrollbar-width: thin;
        scrollbar-color: var(--accent) transparent;
    }

    .links a {
        color: var(--text-soft);
        font-size: 0.95rem;
        text-decoration: none;
    }

    .theme-toggle {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        margin-right: 4px;
        background: var(--accent);
        border: none;
        cursor: pointer;
        border-radius: 50%;
    }
</style>

<script>
    const boton = document.getElementById("theme-toggle");

    boton.addEventListener("click", () => {
        const html = document.documentElement;
        const nuevoTema = html.dataset.theme === "light" ? "dark" : "light";

        html.dataset.theme = nuevoTema;
        localStorage.setItem("tema", nuevoTema);
    });
</script>
