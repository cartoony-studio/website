<header class="navbar">

    <a class="logo" href="/">Cartoony Studio</a>

    <nav class="links">
        <a href="/cartoony-series">Cartoony Series</a>
        <a href="/projects">Projects</a>
        <a href="/services">Services</a>
        <a href="/studio">Studio</a>
        <a href="/contact">Contact</a>
    </nav>

    <!-- Aquí irá tu icono. Por ahora es un hexágono, y sirve para cambiar de tema. -->
    <button class="theme-toggle" id="theme-toggle" aria-label="Cambiar tema"></button>

</header>

<style>
    .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin: 25px 40px;
        padding: 6px;
        background: var(--navbar-bg);
        border-radius: 999px;
        transition: background 0.2s;
    }

    .logo {
        padding: 14px 30px;
        background: var(--accent);
        border-radius: 999px;
        color: #FFFFFF;
        font-family: var(--font-sans);
        font-size: 1.35rem;
        font-weight: bold;
        text-decoration: none;
    }

    .links {
        display: flex;
        gap: 3rem;
    }

    .links a {
        color: var(--text-soft);
        font-size: 0.95rem;
        text-decoration: none;
    }

    .theme-toggle {
        width: 34px;
        height: 34px;
        margin-right: 8px;
        background: var(--accent);
        border: none;
        cursor: pointer;
        /* Estas coordenadas le dan la forma de hexágono */
        clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    }
</style>

<script>
    const boton = document.getElementById("theme-toggle");

    boton.addEventListener("click", () => {
        const html = document.documentElement;
        const nuevoTema = html.dataset.theme === "light" ? "dark" : "light";

        html.dataset.theme = nuevoTema;
        localStorage.setItem("tema", nuevoTema);
    });
</script>
